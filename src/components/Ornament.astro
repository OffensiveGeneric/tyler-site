---
import dividerUrl from "../ornaments/divider.svg";
import vineUrl from "../ornaments/rule-vine.svg";
import rosetteUrl from "../ornaments/rosette.svg";
import cornerUrl from "../ornaments/corner-leaf.svg";
import frameCornerUrl from "../ornaments/frame-corner.svg";

interface Props {
  kind?: "divider" | "vine" | "rosette" | "corner" | "frame-corner";
  label?: string;
}

const { kind = "divider", label } = Astro.props;
const images = { divider: dividerUrl, vine: vineUrl, rosette: rosetteUrl, corner: cornerUrl, "frame-corner": frameCornerUrl };
const image = images[kind];
---

{kind === "divider" && (
  <div class="ornament ornament-divider" aria-hidden="true">
    <span class="ornament-symbol" style={`--ornament-image: url(${image})`}></span><span class="ornament-rule"></span><span class="ornament-label">{label ?? ""}</span><span class="ornament-rule"></span><span class="ornament-symbol" style={`--ornament-image: url(${image})`}></span>
  </div>
)}
{kind !== "divider" && (
  <span class:list={["ornament", `ornament-${kind}`]} style={`--ornament-image: url(${image})`} aria-hidden="true"></span>
)}
