---
interface Props {
  kind?: "divider" | "vine" | "vertical-vine" | "rosette" | "corner" | "frame-corner" | "stained-glass";
  label?: string;
}

const { kind = "divider", label } = Astro.props;
---

{kind === "divider" && (
  <div class="ornament ornament-divider" aria-hidden="true">
    <svg class="ornament-symbol" viewBox="0 0 24 24"><path d="M12 1 14.4 9.6 23 12l-8.6 2.4L12 23l-2.4-8.6L1 12l8.6-2.4L12 1Z" /></svg>
    <span class="ornament-rule"></span><span class="ornament-label">{label ?? ""}</span><span class="ornament-rule"></span>
    <svg class="ornament-symbol" viewBox="0 0 24 24"><path d="M12 1 14.4 9.6 23 12l-8.6 2.4L12 23l-2.4-8.6L1 12l8.6-2.4L12 1Z" /></svg>
  </div>
)}
{kind === "vine" && (
  <svg class="ornament ornament-vine" viewBox="0 0 160 24" aria-hidden="true"><path fill="none" stroke="currentColor" d="M1 12h158M25 12c7-10 14-10 21 0s14 10 21 0 14-10 21 0 14 10 21 0 14-10 21 0"/><path fill="currentColor" d="M43 7c-5-5-10-3-12 2 5 1 9 0 12-2Zm74 10c5 5 10 3 12-2-5-1-9 0-12 2Z"/></svg>
)}
{kind === "vertical-vine" && (
  <svg class="ornament ornament-vine-vertical" viewBox="0 0 64 180" aria-hidden="true">
    <g class="vine-left">
      <path fill="none" stroke="currentColor" d="M24 1v16c0 8-10 8-10 17s10 9 10 18-10 9-10 18 10 9 10 18-10 9-10 18 10 9 10 18-10 9-10 18 10 9 10 18v18" />
      <path fill="currentColor" d="M19 31c-6-6-10-3-10 3 5 1 8 0 10-3Zm-0 27c-6-6-10-3-10 3 5 1 8 0 10-3Zm0 27c-6-6-10-3-10 3 5 1 8 0 10-3Zm0 27c-6-6-10-3-10 3 5 1 8 0 10-3Zm0 27c-6-6-10-3-10 3 5 1 8 0 10-3Zm0 27c-6-6-10-3-10 3 5 1 8 0 10-3Z" />
    </g>
    <g class="vine-right">
      <path fill="none" stroke="currentColor" d="M40 1v16c0 8 10 8 10 17s-10 9-10 18 10 9 10 18-10 9-10 18 10 9 10 18-10 9-10 18 10 9 10 18-10 9-10 18 10 9 10 18v18" />
      <path fill="currentColor" d="M45 31c6-6 10-3 10 3-5 1-8 0-10-3Zm0 27c6-6 10-3 10 3-5 1-8 0-10-3Zm0 27c6-6 10-3 10 3-5 1-8 0-10-3Zm0 27c6-6 10-3 10 3-5 1-8 0-10-3Zm0 27c6-6 10-3 10 3-5 1-8 0-10-3Zm0 27c6-6 10-3 10 3-5 1-8 0-10-3Z" />
    </g>
  </svg>
)}
{kind === "rosette" && (
  <svg class="ornament ornament-rosette" viewBox="0 0 48 48" aria-hidden="true"><g fill="none" stroke="currentColor"><circle cx="24" cy="24" r="7"/><circle cx="24" cy="24" r="15"/><path d="M24 2v15M24 31v15M2 24h15M31 24h15M8.4 8.4l10.6 10.6M29 29l10.6 10.6M39.6 8.4 29 19M19 29 8.4 39.6"/></g></svg>
)}
{(kind === "corner" || kind === "frame-corner") && (
  <svg class:list={["ornament", `ornament-${kind}`]} viewBox="0 0 100 100" aria-hidden="true"><g fill="none" stroke="currentColor"><path d={kind === "corner" ? "M2 42V2h40M2 20c13 0 21 8 21 21M2 31c8 0 13 5 13 13M2 2c25 0 45 20 45 45" : "M1 44V1h43M1 25c10 0 18 8 18 18M1 34c5 0 10 5 10 10M1 1c31 0 55 24 55 55"}/><path d={kind === "corner" ? "M2 2c11 8 19 18 24 31M2 2c8 11 18 19 31 24" : "M1 1c16 10 27 25 32 43"}/></g></svg>
)}
{kind === "stained-glass" && (
  <svg class="ornament ornament-stained-glass" viewBox="0 0 120 120" role="img" aria-label="Geometric stained-glass ornament">
    <defs>
      <mask id="stained-glass-cutout" maskUnits="userSpaceOnUse">
        <rect width="120" height="120" fill="white" />
        <circle cx="60" cy="60" r="18" fill="black" />
        <path d="M60 4v34M60 82v34M4 60h34M82 60h34M20 20l24 24M76 76l24 24M100 20 76 44M44 76 20 100" stroke="black" stroke-width="7" />
      </mask>
    </defs>
    <g mask="url(#stained-glass-cutout)" fill="currentColor">
      <path d="M60 0 84 36 120 60 84 84 60 120 36 84 0 60 36 36Z" />
      <circle cx="60" cy="60" r="52" fill="none" stroke="currentColor" stroke-width="4" />
    </g>
    <circle cx="60" cy="60" r="8" fill="none" stroke="currentColor" stroke-width="2" />
  </svg>
)}
