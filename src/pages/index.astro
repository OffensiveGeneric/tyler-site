---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Welcome to Tyler Kleint's personal site." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
    <ClientRouter />
    <title>Welcome — Tyler Kleint</title>
  </head>
  <body class="landing-body">
    <main class="landing-page">
      <svg class="landing-filter-defs" aria-hidden="true" focusable="false">
        <defs>
          <filter id="landing-glass-softness" x="-20%" y="-20%" width="140%" height="140%">
            <feTurbulence type="fractalNoise" baseFrequency=".008 .018" numOctaves="3" seed="14" result="glass-noise" />
            <feDisplacementMap in="SourceGraphic" in2="glass-noise" scale="9" xChannelSelector="R" yChannelSelector="G" />
            <feGaussianBlur stdDeviation=".25" />
          </filter>
        </defs>
      </svg>

      <section class="landing-stage" aria-labelledby="welcome-heading">
        <div class="landing-pattern" aria-hidden="true"></div>
        <div class="landing-pattern-lit" aria-hidden="true"></div>
        <div class="landing-backlight" aria-hidden="true"></div>
        <div class="landing-spill landing-spill-one" aria-hidden="true"></div>
        <div class="landing-spill landing-spill-two" aria-hidden="true"></div>
        <div class="landing-wordmark" aria-hidden="true">TYLER KLEINT / PERSONAL SITE</div>
        <h1 id="welcome-heading">WELCOME</h1>
        <span class="welcome-light" aria-hidden="true">WELCOME</span>
        <p class="landing-instruction">Scroll into the light</p>
        <a class="landing-enter" href="/cv">Enter site <span aria-hidden="true">→</span></a>
      </section>
    </main>
  </body>
</html>

<style>
  :global(html) {
    background: #030504;
  }

  :global(body.landing-body) {
    min-width: 320px;
    margin: 0;
    padding: 0;
    background: #030504;
    color: #f4efdc;
  }

  :global(body.landing-body) * { box-sizing: border-box; }

  .landing-page {
    --landing-blue: #1d6fbc;
    --landing-cyan: #16c5df;
    --landing-amber: #e4a92e;
    --landing-yellow: #f4d56b;
    min-height: 220vh;
    overflow: clip;
    background: #030504;
  }

  .landing-stage {
    position: sticky;
    top: 0;
    display: grid;
    min-height: 100svh;
    place-items: center;
    isolation: isolate;
    overflow: hidden;
    padding: 4rem 1.5rem;
    background:
      radial-gradient(circle at 50% 48%, rgba(14, 35, 35, .22), transparent 37rem),
      #030504;
  }

  .landing-stage::before,
  .landing-stage::after {
    position: absolute;
    inset: -25%;
    z-index: -2;
    pointer-events: none;
    content: "";
  }

  .landing-stage::before {
    background:
      radial-gradient(ellipse at 72% 24%, rgba(22, 197, 223, .1), transparent 23%),
      radial-gradient(ellipse at 27% 69%, rgba(228, 169, 46, .08), transparent 28%);
    filter: blur(3rem);
    opacity: .75;
  }

  .landing-stage::after {
    z-index: 4;
    border: 1px solid rgba(244, 213, 107, .14);
    inset: 1.2rem;
    opacity: .5;
  }

  .landing-pattern,
  .landing-pattern-lit,
  .landing-backlight {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .landing-pattern,
  .landing-pattern-lit {
    background-image: url("../ornaments/fan-tracery-tile.svg");
    background-position: center;
    background-repeat: repeat;
    background-size: clamp(11rem, 24vw, 22rem) auto;
  }

  .landing-pattern {
    z-index: -4;
    display: none;
  }

  .landing-pattern-lit {
    z-index: -2;
    inset: -18%;
    filter: brightness(1.25) saturate(1.55) contrast(1.05);
    opacity: .02;
    -webkit-mask-image: radial-gradient(ellipse 48% 66% at 30% 52%, #000 0 8%, rgba(0, 0, 0, .88) 26%, transparent 76%);
    mask-image: radial-gradient(ellipse 48% 66% at 30% 52%, #000 0 8%, rgba(0, 0, 0, .88) 26%, transparent 76%);
    animation: pattern-light 18s ease-in-out infinite alternate;
    will-change: transform, opacity;
  }

  .landing-backlight {
    z-index: -1;
    inset: -25%;
    background:
      radial-gradient(ellipse at 30% 50%, rgba(16, 190, 224, .34), transparent 26%),
      radial-gradient(ellipse at 68% 42%, rgba(242, 190, 58, .2), transparent 23%);
    filter: blur(4rem);
    mix-blend-mode: screen;
    opacity: .16;
    animation: backlight-drift 16s ease-in-out infinite alternate;
    will-change: transform, opacity;
  }

  .landing-filter-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .landing-wordmark {
    position: absolute;
    top: 2.1rem;
    z-index: 5;
    color: rgba(244, 239, 220, .42);
    font: .61rem/1 var(--mono, "IBM Plex Mono", monospace);
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .landing-stage h1,
  .welcome-light {
    grid-area: 1 / 1;
    margin: 0;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(5.2rem, 18vw, 15rem);
    font-weight: 500;
    letter-spacing: .035em;
    line-height: .72;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .landing-stage h1 {
    background: rgba(0, 0, 0, .72);
    box-shadow: 0 0 2.5rem rgba(0, 0, 0, .72);
    color: rgba(244, 239, 220, .88);
    padding: .08em .12em .14em;
    text-shadow: 0 0 1px rgba(244, 239, 220, .7);
  }

  .welcome-light {
    display: none;
    z-index: 2;
    color: transparent;
    background: url("../ornaments/fan-tracery-tile.svg") center / 26rem 27.6rem repeat;
    -webkit-background-clip: text;
    background-clip: text;
    filter: url(#landing-glass-softness) saturate(1.25) brightness(1.12);
    opacity: .14;
    mix-blend-mode: screen;
    animation: welcome-reveal 22s ease-in-out infinite alternate;
  }

  .landing-spill {
    display: none;
  }

  .landing-spill-one { top: -22%; left: -30%; }
  .landing-spill-two {
    right: -30%;
    bottom: -25%;
    opacity: .075;
    transform: rotate(17deg) scale(1.1);
    animation-delay: -8s;
  }

  .landing-instruction,
  .landing-enter {
    position: absolute;
    z-index: 6;
    font-family: var(--mono, "IBM Plex Mono", monospace);
    font-size: .65rem;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .landing-instruction {
    bottom: 4.6rem;
    margin: 0;
    color: rgba(244, 239, 220, .4);
    animation: instruction-breathe 4s ease-in-out infinite;
  }

  .landing-enter {
    right: 3rem;
    bottom: 3rem;
    border-bottom: 1px solid var(--landing-yellow);
    padding: .45rem 0;
    color: var(--landing-yellow);
    text-decoration: none;
    transition: color 180ms ease, border-color 180ms ease, transform 180ms ease;
  }

  .landing-enter span { display: inline-block; margin-left: .5rem; transition: transform 180ms ease; }
  .landing-enter:hover { color: white; border-color: white; }
  .landing-enter:hover span { transform: translateX(.25rem); }
  .landing-enter:focus-visible { outline: 2px solid var(--landing-yellow); outline-offset: 6px; }

  @supports (animation-timeline: scroll()) {
    .welcome-light,
    .landing-spill-one,
    .landing-spill-two,
    .landing-instruction {
      animation-timeline: scroll(root);
      animation-range: 0 100%;
    }

    .welcome-light { animation-name: scroll-reveal; animation-duration: 1s; animation-fill-mode: both; }
    .landing-spill-one { animation-name: scroll-light-one; animation-duration: 1s; animation-fill-mode: both; }
    .landing-spill-two { animation-name: scroll-light-two; animation-duration: 1s; animation-fill-mode: both; }
    .landing-instruction { animation-name: scroll-instruction; animation-duration: 1s; animation-fill-mode: both; }
  }

  @keyframes welcome-reveal {
    from { background-position: 10% 45%; opacity: .08; }
    to { background-position: 90% 55%; opacity: .46; }
  }

  @keyframes light-drift {
    from { background-position: 0 0; transform: rotate(-9deg) translate(-4%, -2%); }
    to { background-position: 12rem -8rem; transform: rotate(-5deg) translate(8%, 5%); }
  }

  @keyframes pattern-light {
    from {
      transform: translate(-10%, 1%);
      opacity: .02;
    }
    to {
      transform: translate(10%, -2%);
      opacity: .78;
    }
  }

  @keyframes backlight-drift {
    from { transform: translate(-8%, 2%) scale(.95); }
    to { transform: translate(8%, -3%) scale(1.08); }
  }

  @keyframes instruction-breathe { 50% { opacity: .58; } }

  @keyframes scroll-reveal {
    0% { background-position: 0 45%; opacity: .05; }
    55% { background-position: 55% 50%; opacity: .3; }
    100% { background-position: 100% 55%; opacity: .52; }
  }

  @keyframes scroll-light-one {
    0% { background-position: 0 0; transform: rotate(-9deg) translate(-14%, -5%); opacity: .045; }
    55% { background-position: 9rem -4rem; transform: rotate(-5deg) translate(4%, 2%); opacity: .13; }
    100% { background-position: 18rem -9rem; transform: rotate(1deg) translate(18%, 7%); opacity: .2; }
  }

  @keyframes scroll-light-two {
    0% { background-position: 0 0; transform: rotate(17deg) scale(1.1) translate(12%, 7%); opacity: .035; }
    100% { background-position: -15rem 8rem; transform: rotate(9deg) scale(1.1) translate(-8%, -3%); opacity: .12; }
  }

  @keyframes scroll-instruction {
    0%, 55% { opacity: .58; }
    100% { opacity: 0; }
  }

  @media (max-width: 620px) {
    .landing-stage { padding-inline: .75rem; }
    .landing-stage h1, .welcome-light { font-size: clamp(3.25rem, 17vw, 7.5rem); letter-spacing: .01em; }
    .landing-wordmark { top: 1.7rem; font-size: .52rem; }
    .landing-stage::after { inset: .65rem; }
    .landing-enter { right: 1.6rem; bottom: 1.8rem; }
    .landing-instruction { bottom: 4rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .welcome-light {
      animation: none;
      background-position: 55% 50%;
      opacity: .58;
    }

    .landing-pattern-lit {
      animation: none;
      -webkit-mask-position: 50% 50%;
      mask-position: 50% 50%;
      opacity: .62;
    }

    .landing-backlight { animation: none; opacity: .3; }

    .landing-spill {
      animation: none;
      opacity: .08;
    }

    .landing-instruction { display: none; }
    .landing-enter { opacity: 1; }
  }

  @media (prefers-reduced-transparency: reduce) {
    .landing-spill { display: none; }
    .welcome-light { filter: none; opacity: .7; }
  }

  @media (prefers-reduced-motion: reduce) {
    .landing-enter span { transition: none; }
  }

  :global(::view-transition-old(root)),
  :global(::view-transition-new(root)) { animation-duration: 700ms; }

  :global(::view-transition-old(root)) { animation-name: landing-fade-out; }
  :global(::view-transition-new(root)) { animation-name: landing-fade-in; }

  @keyframes landing-fade-out { to { opacity: 0; filter: brightness(2) blur(8px); } }
  @keyframes landing-fade-in { from { opacity: 0; filter: brightness(2) blur(8px); } }
</style>
