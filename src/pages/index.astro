---
import SiteLayout from "../layouts/SiteLayout.astro";
import ArchitecturalOrnament from "../components/ArchitecturalOrnament.astro";
---

<SiteLayout title="Home" description="Tyler Kleint is a Linux systems administrator and software developer in the Bronx, New York.">
  <section class="home-hero wrapper" aria-labelledby="home-title">
    <div class="home-pattern" aria-hidden="true"></div>
    <p class="eyebrow">Systems · software · photography</p>
    <h1 id="home-title">Tyler Kleint</h1>
    <p class="home-role">Linux systems administrator and software developer in the Bronx, New York.</p>
    <nav class="home-actions" aria-label="Featured destinations">
      <a href="/cv">Read the CV <span aria-hidden="true">→</span></a>
      <a href="/photography">View photography <span aria-hidden="true">→</span></a>
    </nav>
    <ArchitecturalOrnament kind="rosette" class="home-rosette" />
  </section>
</SiteLayout>

<style>
  .home-hero { position: relative; display: grid; min-height: calc(100svh - 5rem); align-content: center; isolation: isolate; overflow: hidden; padding-block: clamp(6rem, 14vw, 11rem); }
  .home-pattern { position: absolute; z-index: -1; inset: 8% 0 8% 38%; background: url("/ornaments/fan-tracery-landing.svg") center / clamp(12rem, 24vw, 22rem) auto repeat; opacity: .12; mask-image: linear-gradient(90deg, transparent, #000 30% 80%, transparent); }
  .home-hero h1 { max-width: 9ch; font-size: clamp(5rem, 14vw, 12rem); text-wrap: balance; }
  .home-role { max-width: 34ch; margin: 1.5rem 0 0; color: var(--muted); font-size: clamp(1.2rem, 2vw, 1.55rem); }
  .home-actions { display: flex; flex-wrap: wrap; gap: 1rem 2rem; margin-top: 2.5rem; font: .8rem var(--mono); letter-spacing: .06em; text-transform: uppercase; }
  .home-actions a { border-bottom: 1px solid var(--gold-text); padding-bottom: .3rem; color: var(--oxblood); }
  .home-actions a:hover { color: var(--ultramarine); }
  :global(.home-rosette) { position: absolute; right: 8%; bottom: 12%; width: clamp(4rem, 9vw, 8rem); height: auto; color: var(--gold); opacity: .8; }
  @media (max-width: 650px) { .home-hero { min-height: auto; } .home-pattern { inset-inline: 20% -40%; } }
</style>
