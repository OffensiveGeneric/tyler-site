---
import SiteLayout from "../layouts/SiteLayout.astro";
import ArchitecturalOrnament from "../components/ArchitecturalOrnament.astro";
import { getCollection } from "astro:content";

export const prerender = false;
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<SiteLayout title="Writing">
  <article class="blog-index wrapper">
    <header class="blog-masthead">
      <div class="blog-register" aria-label="Writing index status">
        <span>REGISTER / {String(posts.length).padStart(2, "0")}</span>
        <span>OOKNULSUS.COM</span>
      </div>
      <p class="blog-kicker">Writing &amp; field notes</p>
      <h1>Notes too marvelous to be contained within the margin.</h1>
      <p class="blog-dek">Essays, field notes, and occasional explanations of what I’m building and why.</p>
      <div class="blog-light" aria-hidden="true"></div>
    </header>

    <div class:list={["blog-ledger", { "has-entries": posts.length > 0 }]}>
      <aside class="ledger-band" aria-hidden="true"><span>INDEX · INDEX · INDEX · INDEX</span></aside>
      <section class="ledger-entries" aria-label="Writing index">
        <div class="ledger-heading">
          <span>No.</span><span>Entry</span><span>Date</span>
        </div>
        {posts.length ? (
          <ol class="editorial-list">
            {posts.map((post) => (
              <li class="editorial-entry">
                <span class="entry-number" aria-hidden="true"></span>
                <div class="entry-copy">
                  <h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2>
                  {post.data.description && <p>{post.data.description}</p>}
                  <a class="entry-link" href={`/blog/${post.id}`}>Open entry <span aria-hidden="true">→</span></a>
                </div>
                <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}</time>
                <div class="entry-divider" aria-hidden="true"><span></span><ArchitecturalOrnament kind="rosette" class="entry-rosette" /><span></span></div>
              </li>
            ))}
          </ol>
        ) : (
          <div class="empty-register">
            <ArchitecturalOrnament kind="panel" class="empty-frame" />
            <span class="empty-number">[00]</span>
            <div>
              <h2>The first entry is still being written.</h2>
            </div>
          </div>
        )}
      </section>
    </div>

    <footer class="blog-colophon">
      <ArchitecturalOrnament kind="rosette" class="blog-rosette" />
      <p><span>INDEX STATUS</span> ONLINE / HAND-SET / NO TRACKING</p>
    </footer>
  </article>
</SiteLayout>

<style>
  .blog-index { max-width: 1080px; padding: clamp(4rem, 9vw, 8rem) 0 6rem; container: blog-index / inline-size; }
  .blog-masthead { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); border-block: 3px double var(--gold-shadow); padding: clamp(2.5rem, 7vw, 5rem) clamp(1rem, 5vw, 4rem); }
  .blog-masthead::before { position: absolute; inset: .45rem 0; border-block: 1px solid var(--oxblood); content: ""; pointer-events: none; }
  .blog-register { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: clamp(3rem, 7vw, 6rem); color: var(--muted); font: .6rem/1.4 var(--mono); letter-spacing: .09em; }
  .blog-kicker { margin: 0 0 1rem; color: var(--oxblood); font: .66rem var(--mono); letter-spacing: .13em; text-transform: uppercase; }
  .blog-masthead h1 { max-width: 12ch; font-size: clamp(4rem, 12cqi, 8rem); text-wrap: balance; }
  .blog-dek { max-width: 40ch; margin: 1.5rem 0 0; color: var(--muted); font-size: 1.18rem; }
  .blog-light { position: absolute; right: clamp(1rem, 5vw, 4rem); bottom: 3rem; width: min(30%, 13rem); height: .65rem; background: linear-gradient(90deg, var(--lapis), var(--emerald), var(--gold), var(--cinnabar), var(--violet)); mask: url("../ornaments/lattice-tile.svg") center / 1.4rem 1.4rem repeat-x; }

  .blog-ledger { display: grid; grid-template-columns: clamp(2.2rem, 6vw, 4rem) minmax(0, 1fr); margin-top: 2rem; border: 1px solid var(--gold-shadow); background: color-mix(in oklch, var(--warm-stone), white 12%); }
  .ledger-band { position: relative; overflow: hidden; border-right: 1px solid var(--gold-shadow); background: var(--shadow-field); color: var(--gold); }
  .ledger-band::before { position: absolute; inset: 0; background: currentColor; content: ""; opacity: .75; mask: url("../ornaments/lattice-tile.svg") center top / 1.7rem 1.7rem repeat; }
  .ledger-band span { position: relative; z-index: 1; display: block; margin: 1rem auto; color: var(--paper); font: .54rem var(--mono); letter-spacing: .13em; writing-mode: vertical-rl; }
  .ledger-entries { display: grid; min-width: 0; grid-template-columns: 3.2rem minmax(0, 1fr) 8rem; column-gap: 1rem; padding: clamp(1.5rem, 5vw, 4rem); }
  .ledger-heading { display: grid; grid-column: 1 / -1; grid-template-columns: subgrid; border-bottom: 1px solid var(--gold-shadow); padding-bottom: .65rem; color: var(--oxblood); font: .58rem var(--mono); letter-spacing: .1em; text-transform: uppercase; }
  .editorial-list { display: grid; grid-column: 1 / -1; grid-template-columns: subgrid; margin: 0; padding: 0; list-style: none; counter-reset: entry; }
  .editorial-entry { display: grid; grid-column: 1 / -1; grid-template-columns: subgrid; padding-top: 2.5rem; counter-increment: entry; content-visibility: auto; contain-intrinsic-size: auto 16rem; }
  .entry-number::before { color: var(--gold-shadow); content: counter(entry, decimal-leading-zero); font: 1rem var(--mono); }
  .entry-copy { min-width: 0; }
  .entry-copy h2 { max-width: 16ch; font-size: clamp(2.6rem, 7cqi, 5rem); text-wrap: balance; }
  .entry-copy h2 a { text-decoration-line: underline; text-decoration-color: transparent; text-decoration-thickness: 1px; text-underline-offset: .15em; transition: color 160ms ease, text-decoration-color 160ms ease; }
  .entry-copy h2 a:hover { color: var(--oxblood); text-decoration-color: var(--gold); }
  .entry-copy p { margin: 1rem 0 0; color: var(--muted); font-size: 1.08rem; }
  .entry-link { display: inline-block; margin-top: 1.1rem; border-bottom: 1px solid var(--gold); color: var(--oxblood); font: .62rem var(--mono); letter-spacing: .06em; text-transform: uppercase; }
  .editorial-entry time { color: var(--muted); font: .62rem/1.6 var(--mono); text-transform: uppercase; }
  .entry-divider { display: grid; grid-column: 1 / -1; grid-template-columns: 1fr auto 1fr; gap: .8rem; align-items: center; margin-top: 2rem; color: var(--gold-shadow); }
  .entry-divider > span { height: 1px; background: currentColor; }
  :global(.entry-rosette) { width: 2rem; height: 2rem; }
  :global(.entry-rosette svg), :global(.blog-rosette svg) { display: block; width: 100%; height: 100%; }

  .empty-register { position: relative; display: grid; grid-column: 1 / -1; grid-template-columns: auto minmax(0, 1fr); gap: clamp(1.2rem, 4vw, 3rem); align-items: center; min-height: 19rem; padding: clamp(2rem, 6vw, 4.5rem); background: color-mix(in oklch, var(--oxblood), var(--paper) 91%); }
  :global(.empty-frame) { position: absolute; inset: 0; color: var(--gold-shadow); pointer-events: none; }
  :global(.empty-frame svg) { width: 100%; height: 100%; }
  .empty-number { color: var(--oxblood); font: .72rem var(--mono); }
  .empty-register h2 { max-width: 15ch; font-size: clamp(2.6rem, 7cqi, 4.8rem); text-wrap: balance; }
  .blog-colophon { display: grid; justify-items: center; padding-top: 3.5rem; color: var(--muted); font: .58rem var(--mono); letter-spacing: .08em; text-align: center; text-transform: uppercase; }
  .blog-colophon p { margin: .8rem 0 0; }
  .blog-colophon span { color: var(--oxblood); }
  :global(.blog-rosette) { width: 2.5rem; height: 2.5rem; color: var(--gold-shadow); }

  @container blog-index (min-width: 49rem) {
    .blog-masthead { grid-template-columns: minmax(0, 1.4fr) minmax(14rem, .6fr); }
    .blog-register, .blog-kicker, .blog-masthead h1 { grid-column: 1; }
    .blog-dek { grid-column: 2; grid-row: 3 / span 2; align-self: end; margin: 0 0 .5rem; }
  }

  @media (max-width: 560px) {
    .blog-index { width: min(100% - 1.25rem, 1080px); }
    .blog-light { right: 1rem; bottom: 1.5rem; width: 35%; }
    .blog-ledger { grid-template-columns: 1.6rem minmax(0, 1fr); }
    .ledger-band span { display: none; }
    .ledger-entries { grid-template-columns: 2.3rem minmax(0, 1fr); column-gap: .7rem; padding: 1.25rem; }
    .ledger-heading span:last-child { display: none; }
    .editorial-entry time { grid-column: 2; grid-row: 1; margin-bottom: .4rem; }
    .entry-copy { grid-column: 2; padding-top: 1.7rem; }
    .entry-number { grid-row: 1 / span 2; }
    .empty-register { grid-template-columns: 1fr; }
  }
</style>
