---
import SiteLayout from "../layouts/SiteLayout.astro";
import { db } from "../db/client";
import { photos } from "../db/schema";
import { asc } from "drizzle-orm";

export const prerender = false;
const gallery = db.select().from(photos).orderBy(asc(photos.createdAt), asc(photos.id)).all();
const sourceSet = (photo: typeof gallery[number], format: "Avif" | "Webp") => [
  photo[`thumb${format}`] && `/media/${photo[`thumb${format}`]} 480w`,
  photo[`medium${format}`] && `/media/${photo[`medium${format}`]} 1400w`,
  photo[`large${format}`] && `/media/${photo[`large${format}`]} 2400w`,
].filter(Boolean).join(", ");
---
<SiteLayout title="Photography" mode="contact">
  <section class="wrapper page-intro">
    <p class="eyebrow">Photography</p><h1>Film scans.</h1>
    <p>Around 2021 I was given an enlarger by my dad's old friend Ed. I spent the next several years in the darkroom, and in the streets with my skateboard and camera nearly always at my side.</p>
  </section>
  <section class="wrapper content-grid">
    <div>{gallery.length ? `${gallery.length} photograph${gallery.length === 1 ? "" : "s"}` : "Coming soon"}</div>
    <div>
      {gallery.length ? (
        <div class="photo-grid">
          {gallery.map((photo) => <figure><a class="photo-link" href={`/photography/${photo.slug}`} aria-label={`Open ${photo.title ?? "photograph"}`}><picture>{sourceSet(photo, "Avif") && <source type="image/avif" srcset={sourceSet(photo, "Avif")} sizes="(max-width: 650px) 45vw, 20vw" />}{sourceSet(photo, "Webp") && <source type="image/webp" srcset={sourceSet(photo, "Webp")} sizes="(max-width: 650px) 45vw, 20vw" />}<img src={`/media/${photo.largeAvif ?? photo.filename}`} alt={photo.title ?? ""} loading="lazy" transition:name={`photo-${photo.slug}`} /></picture></a><figcaption>{photo.caption ?? photo.filename}</figcaption></figure>)}
        </div>
      ) : (
        <><p>The gallery is still being prepared. This space will eventually hold locally served photographs with thoughtful metadata and generous room to look.</p><div class="placeholder" aria-hidden="true">The first roll is developing.</div></>
      )}
    </div>
  </section>
</SiteLayout>
