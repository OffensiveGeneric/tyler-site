---
import SiteLayout from "../layouts/SiteLayout.astro";
import ArchitecturalOrnament from "../components/ArchitecturalOrnament.astro";
---
<SiteLayout title="About">
  <article class="about-page wrapper">
    <div class="about-sidework about-sidework-left" aria-hidden="true">
      <span class="about-edge-rail"></span><span class="about-lattice"></span><span class="about-edge-rail"></span>
    </div>
    <div class="about-sidework about-sidework-right" aria-hidden="true">
      <span class="about-edge-rail"></span><span class="about-lattice"></span><span class="about-edge-rail"></span>
    </div>
    <div class="about-fanwork about-fanwork-left" aria-hidden="true"></div>
    <div class="about-fanwork about-fanwork-right" aria-hidden="true"></div>

    <header class="about-masthead">
      <ArchitecturalOrnament kind="arch" class="about-arch" />
      <p class="about-folio">FOLIO / 04</p>
      <ArchitecturalOrnament kind="rosette" class="about-rose-window" />
      <p class="about-kicker">A little context</p>
      <h1>About</h1>
    </header>

    <div class="spectral-tracery" aria-hidden="true"></div>

    <figure class="about-portrait">
      <div class="about-portrait-frame">
        <ArchitecturalOrnament kind="panel" class="about-portrait-ornament" />
        <picture>
          <source
            type="image/avif"
            srcset="/images/about/tyler-portrait-720.avif 720w, /images/about/tyler-portrait-1400.avif 1400w"
            sizes="(max-width: 650px) calc(100vw - 5rem), 430px"
          />
          <source
            type="image/webp"
            srcset="/images/about/tyler-portrait-720.webp 720w, /images/about/tyler-portrait-1400.webp 1400w"
            sizes="(max-width: 650px) calc(100vw - 5rem), 430px"
          />
          <img
            src="/images/about/tyler-portrait-1400.webp"
            alt="Black-and-white portrait of Tyler wearing glasses and a plaid shirt with a flower pinned to the pocket."
            width="1400"
            height="2107"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </div>
      <figcaption><span>PORTRAIT / TK</span><span>BLACK &amp; WHITE</span></figcaption>
    </figure>

    <div class="about-compartments">
      <section class="inset-panel inset-panel-context" aria-labelledby="about-context-heading">
        <ArchitecturalOrnament kind="panel" class="panel-ornament" />
        <p class="panel-index">I / THE ROOM</p>
        <h2 id="about-context-heading">A corner made by hand.</h2>
        <p>This is Tyler’s corner of the web: part notebook, part portfolio, and part excuse to keep learning how the web works.</p>
      </section>

      <div class="rosette-passage" aria-hidden="true">
        <span></span><ArchitecturalOrnament kind="rosette" class="about-rosette" /><span></span>
      </div>

      <section class="inset-panel inset-panel-principles" aria-labelledby="about-principles-heading">
        <ArchitecturalOrnament kind="panel" class="panel-ornament" />
        <p class="panel-index">II / PRINCIPLES</p>
        <h2 id="about-principles-heading">Keep the joinery visible.</h2>
        <p>Keep the technology understandable. Let the browser do the work. Make things that reward a slower look.</p>
      </section>
    </div>

    <footer class="about-colophon">
      <ArchitecturalOrnament kind="rosette" class="colophon-rosette" />
      <p><span>SITE CONSTRUCTION</span> ASTRO / SEMANTIC HTML / CSS / SVG</p>
      <p><span>STATUS</span> HAND-BUILT / ONLINE</p>
    </footer>
  </article>
</SiteLayout>

<style>
  .about-page {
    position: relative;
    isolation: isolate;
    max-width: 980px;
    padding: clamp(3rem, 7vw, 6rem) clamp(2.2rem, 6vw, 5.5rem) 6rem;
    container: about-page / inline-size;
  }

  .about-page::before {
    position: absolute;
    z-index: -2;
    inset: 1.5rem 1.2rem 3rem;
    border: 1px solid var(--gold-shadow);
    outline: 1px solid color-mix(in oklch, var(--oxblood), transparent 35%);
    outline-offset: .45rem;
    background: color-mix(in oklch, var(--warm-stone), white 16%);
    content: "";
  }

  .about-sidework {
    position: absolute;
    z-index: -1;
    top: 2.15rem;
    bottom: 3.65rem;
    display: grid;
    width: clamp(2.15rem, 4.5vw, 3.25rem);
    grid-template-columns: .58rem minmax(0, 1fr) .58rem;
    gap: .12rem;
  }

  .about-sidework-left { left: .62rem; }
  .about-sidework-right { right: .62rem; }

  .about-fanwork {
    position: absolute;
    z-index: 0;
    top: 2.15rem;
    bottom: 3.65rem;
    width: clamp(3.25rem, 7vw, 5.5rem);
    background: transparent url("/ornaments/fan-tracery-landing.svg") center top / 100% auto repeat-y;
    opacity: .9;
    pointer-events: none;
  }

  .about-fanwork-left {
    left: calc(.62rem - clamp(3.25rem, 7vw, 5.5rem));
  }

  .about-fanwork-right {
    right: calc(.62rem - clamp(3.25rem, 7vw, 5.5rem));
    transform: scaleX(-1);
  }

  .about-lattice {
    position: relative;
    background: var(--shadow-field);
    color: var(--gold);
    opacity: .9;
  }

  .about-lattice::after {
    position: absolute;
    inset: 0;
    background: currentColor;
    content: "";
    mask: url("../ornaments/lattice-tile.svg") center top / 1.5rem 1.5rem repeat;
  }

  .about-edge-rail {
    position: relative;
    border-inline: 1px solid var(--gold-shadow);
    background:
      repeating-linear-gradient(
        to bottom,
        transparent 0 1.9rem,
        var(--gold-shadow) 1.9rem 2rem,
        var(--gold-highlight) 2rem 2.08rem,
        transparent 2.08rem 3.95rem
      ),
      linear-gradient(
        to right,
        var(--gold-shadow) 0 1px,
        var(--gold) 1px 2px,
        var(--oxblood) 2px calc(100% - 2px),
        var(--gold) calc(100% - 2px) calc(100% - 1px),
        var(--gold-shadow) calc(100% - 1px)
      );
    box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--cinnabar), transparent 38%);
  }

  .about-edge-rail::after {
    position: absolute;
    inset: .35rem .03rem;
    background:
      radial-gradient(
        circle,
        var(--gold-highlight) 0 16%,
        var(--oxblood) 18% 32%,
        var(--gold) 34% 50%,
        transparent 53%
      ) center top / .45rem 3.95rem repeat-y;
    content: "";
  }

  .about-masthead {
    position: relative;
    display: grid;
    min-height: clamp(24rem, 58vw, 36rem);
    place-content: center;
    justify-items: center;
    padding: clamp(6rem, 14vw, 10rem) clamp(1rem, 6vw, 5rem) 4rem;
    text-align: center;
  }

  :global(.about-arch) {
    position: absolute;
    inset: 0;
    color: var(--gold-shadow);
    pointer-events: none;
  }

  :global(.about-arch svg) { width: 100%; height: 100%; overflow: visible; }
  :global(.about-arch path) { stroke-dasharray: 1200; animation: arch-reveal 1.4s cubic-bezier(.22, .61, .36, 1) both; }
  :global(.about-arch .arch-pipes) { opacity: .13; }

  :global(.about-rose-window) {
    z-index: 1;
    width: clamp(5.5rem, 12cqi, 8rem);
    height: clamp(5.5rem, 12cqi, 8rem);
    margin-bottom: 1.1rem;
    color: var(--gold-shadow);
    --rosette-glass: color-mix(in oklch, var(--gold-highlight), transparent 42%);
    --rosette-glass-alt: color-mix(in oklch, var(--lapis), transparent 18%);
    --rosette-center: color-mix(in oklch, var(--cinnabar), transparent 68%);
    filter: drop-shadow(0 0 .45rem color-mix(in oklch, var(--gold), transparent 60%));
  }

  :global(.about-rose-window svg) { display: block; width: 100%; height: 100%; }

  .about-folio,
  .about-kicker,
  .panel-index,
  .about-colophon {
    font-family: var(--mono);
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  .about-folio { position: absolute; top: 2rem; margin: 0; color: var(--muted); font-size: .6rem; }
  .about-kicker { margin: 0 0 1rem; color: var(--oxblood); font-size: .66rem; }
  .about-masthead h1 { max-width: none; color: var(--shadow-field); font-size: clamp(5rem, 16cqi, 9rem); text-shadow: 0 1px var(--gold-highlight); }
  .spectral-tracery {
    height: .5rem;
    margin: 0 clamp(1rem, 5vw, 4rem) 3.5rem;
    background: linear-gradient(90deg, var(--lapis), var(--emerald) 25%, var(--gold) 48%, var(--cinnabar) 72%, var(--violet));
    mask: url("../ornaments/lattice-tile.svg") center / 1.35rem 1.35rem repeat-x;
    filter: saturate(.85);
  }

  .about-portrait {
    width: min(27rem, calc(100% - 2rem));
    margin: 0 auto clamp(3.5rem, 8vw, 5.5rem);
  }

  .about-portrait-frame {
    position: relative;
    padding: clamp(.65rem, 2cqi, 1rem);
    border: 1px solid var(--gold-shadow);
    outline: .35rem solid var(--oxblood);
    outline-offset: 1px;
    background: var(--gold);
    box-shadow:
      0 0 0 .45rem var(--gold-shadow),
      0 0 0 .58rem color-mix(in oklch, var(--oxblood), black 18%);
  }

  .about-portrait-frame picture,
  .about-portrait-frame img {
    display: block;
    width: 100%;
  }

  .about-portrait-frame picture { position: relative; z-index: 1; }
  .about-portrait-frame img {
    height: auto;
    border: 1px solid var(--gold-shadow);
    background: var(--shadow-field);
  }

  :global(.about-portrait-ornament) {
    position: absolute;
    z-index: 2;
    inset: 0;
    color: var(--gold-highlight);
    pointer-events: none;
  }

  :global(.about-portrait-ornament svg) { display: block; width: 100%; height: 100%; }

  .about-portrait figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
    color: var(--muted);
    font: .58rem/1.5 var(--mono);
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  .about-portrait figcaption span:first-child { color: var(--oxblood); }

  .about-compartments { display: grid; gap: 1.5rem; }
  .inset-panel {
    position: relative;
    margin-inline: clamp(.5rem, 3vw, 2.5rem);
    padding: clamp(2rem, 6vw, 4.5rem);
    background: color-mix(in oklch, var(--oxblood), var(--paper) 87%);
  }

  .inset-panel-principles { background: color-mix(in oklch, var(--lapis), var(--paper) 91%); }
  :global(.panel-ornament) { position: absolute; inset: 0; color: var(--gold-shadow); pointer-events: none; }
  :global(.panel-ornament svg) { width: 100%; height: 100%; }
  .panel-index { margin: 0 0 1.25rem; color: var(--oxblood); font-size: .62rem; }
  .inset-panel-principles .panel-index { color: var(--lapis); }
  .inset-panel h2 { max-width: 13ch; font-size: clamp(2.5rem, 7cqi, 4.6rem); text-wrap: balance; }
  .inset-panel p:last-child { margin: 1.4rem 0 0; color: var(--muted); font-size: 1.13rem; }

  .rosette-passage { display: grid; grid-template-columns: 1fr auto 1fr; gap: .9rem; align-items: center; width: min(28rem, 80%); margin: .5rem auto; color: var(--gold-shadow); }
  .rosette-passage > span { height: 1px; background: currentColor; }
  :global(.about-rosette) { width: 3rem; height: 3rem; }
  :global(.about-rosette) { --rosette-glass: color-mix(in oklch, var(--gold), transparent 72%); }
  :global(.about-rosette svg), :global(.colophon-rosette svg) { display: block; width: 100%; height: 100%; }

  .about-colophon { display: grid; justify-items: center; gap: .35rem; padding: 4rem 1rem 1rem; color: var(--muted); font-size: .58rem; text-align: center; }
  .about-colophon p { margin: 0; }
  .about-colophon span { color: var(--oxblood); }
  :global(.colophon-rosette) { width: 2rem; height: 2rem; margin-bottom: .7rem; color: var(--gold-shadow); }

  @keyframes arch-reveal { from { stroke-dashoffset: 1200; opacity: .25; } to { stroke-dashoffset: 0; opacity: 1; } }

  @container about-page (min-width: 43rem) {
    .about-compartments { grid-template-columns: minmax(0, 1fr) 3rem minmax(0, 1fr); align-items: stretch; gap: 1rem; }
    .rosette-passage { grid-template: 1fr auto 1fr / 1fr; width: auto; margin: 1rem 0; }
    .rosette-passage > span { width: 1px; height: 100%; justify-self: center; }
  }

  @media (max-width: 480px) {
    .about-page { padding-inline: 1.5rem; }
    .about-page::before { inset-inline: .35rem; }
    .about-sidework, .about-fanwork { display: none; }
    .about-masthead { min-height: 21rem; padding-inline: .5rem; }
    .about-folio { top: 1rem; }
    .inset-panel { margin-inline: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.about-arch path) { animation: none; stroke-dasharray: none; }
    :global(.about-rose-window) { filter: none; }
  }
</style>
